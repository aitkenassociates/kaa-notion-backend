# Test Environment Variables
# Copy this file and fill in values for local testing

NODE_ENV=test

# Database (use a separate test database)
DATABASE_URL="postgresql://test:test@localhost:5432/kaa_test"

# Supabase Test Instance
SUPABASE_URL="https://test.supabase.co"
SUPABASE_ANON_KEY="test-anon-key"

# Notion (mock or test workspace)
NOTION_API_KEY="test-notion-key"
NOTION_DATABASE_ID="test-database-id"

# Stripe Test Keys
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_test_placeholder"

# OpenAI (mock or test key)
OPENAI_API_KEY="sk-test-placeholder"

# JWT Secret for Testing
JWT_SECRET="test-jwt-secret-for-testing-only"
