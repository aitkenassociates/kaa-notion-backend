# =============================================================================
# SAGE MVP Platform - Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in your values
# NEVER commit actual secrets to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration (REQUIRED)
# -----------------------------------------------------------------------------

# Node environment - MUST be "production" for production deployments
NODE_ENV=production

# Server port (default: 3001)
PORT=3001

# Database connection string with SSL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# IMPORTANT: Always use sslmode=require in production
DATABASE_URL="postgresql://user:password@db.example.com:5432/sage_production?sslmode=require"

# JWT secret for authentication (MINIMUM 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-64-character-random-secret-here-using-the-command-above"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend URL for email links and CORS
FRONTEND_URL="https://app.sage.design"

# CORS origins (comma-separated list of allowed domains)
CORS_ORIGINS="https://app.sage.design,https://www.sage.design"

# -----------------------------------------------------------------------------
# Stripe Integration (REQUIRED for payments)
# -----------------------------------------------------------------------------

# Stripe API keys - get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Stripe webhook signing secret - get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for each tier - get from https://dashboard.stripe.com/products
STRIPE_PRICE_TIER_1="price_..."  # The Concept - $299
STRIPE_PRICE_TIER_2="price_..."  # The Builder - $1,499
STRIPE_PRICE_TIER_3="price_..."  # The Concierge - $4,999
STRIPE_PRICE_TIER_4="price_..."  # White Glove - Custom

# Stripe checkout redirect URLs
STRIPE_SUCCESS_URL="https://app.sage.design/success"
STRIPE_CANCEL_URL="https://app.sage.design/cancel"

# -----------------------------------------------------------------------------
# Supabase Storage (REQUIRED for file uploads)
# -----------------------------------------------------------------------------

# Supabase project URL - get from Project Settings > API
SUPABASE_URL="https://your-project.supabase.co"

# Supabase service role key (NOT the anon key) - get from Project Settings > API
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIs..."

# Storage configuration
STORAGE_BUCKET="deliverables"
MAX_FILE_SIZE_MB=50

# -----------------------------------------------------------------------------
# Email Configuration (REQUIRED for notifications)
# -----------------------------------------------------------------------------

# Option 1: Resend (recommended)
RESEND_API_KEY="re_..."

# Option 2: SMTP (alternative)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="user@example.com"
# SMTP_PASS="password"

# Email sender configuration
EMAIL_FROM="SAGE Landscape Design <hello@sage.design>"
EMAIL_REPLY_TO="support@sage.design"

# -----------------------------------------------------------------------------
# Notion Integration (OPTIONAL)
# -----------------------------------------------------------------------------

# Notion API key - get from https://www.notion.so/my-integrations
NOTION_API_KEY="secret_..."

# Notion database IDs
NOTION_PROJECTS_DATABASE_ID="..."
NOTION_LEADS_DATABASE_ID="..."

# -----------------------------------------------------------------------------
# Monitoring & Observability (RECOMMENDED)
# -----------------------------------------------------------------------------

# Sentry error tracking - get from https://sentry.io
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ENVIRONMENT="production"

# Logging configuration
LOG_LEVEL="info"
LOG_FORMAT="json"
SERVICE_NAME="sage-api-production"

# -----------------------------------------------------------------------------
# Database Connection Pooling
# -----------------------------------------------------------------------------

DATABASE_CONNECTION_LIMIT=20
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_QUERY_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=300000
SLOW_QUERY_THRESHOLD=1000

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT=30000

# -----------------------------------------------------------------------------
# API Documentation (OPTIONAL - disabled in production by default)
# -----------------------------------------------------------------------------

ENABLE_API_DOCS=false

# -----------------------------------------------------------------------------
# Legacy/Deprecated (may be removed in future versions)
# -----------------------------------------------------------------------------

# FIGMA_ACCESS_TOKEN="..."

# =============================================================================
# Deployment Checklist
# =============================================================================
# Before deploying to production, ensure you have:
#
# 1. [ ] Set NODE_ENV=production
# 2. [ ] Generated a strong JWT_SECRET (64+ characters)
# 3. [ ] Configured DATABASE_URL with sslmode=require
# 4. [ ] Set up Stripe with live API keys
# 5. [ ] Configured Supabase storage with service role key
# 6. [ ] Set up email provider (Resend or SMTP)
# 7. [ ] Configured Sentry for error tracking
# 8. [ ] Updated CORS_ORIGINS to match your domains
# 9. [ ] Tested all integrations in staging first
# 10. [ ] Set up database backups and monitoring
# =============================================================================
